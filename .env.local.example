# Copy this file to .env.local and fill in the real values
# MongoDB connection string for local development
MONGO_URI=mongodb://localhost:27017/reachpilot

# JWT signing secret used by backend (keep this secret in production)
JWT_SECRET=replace_with_a_strong_random_string

# Reusable owner-provided code required for every new account.
# Keep this server-only. Never rename it to NEXT_PUBLIC_SIGNUP_ACCESS_CODE.
SIGNUP_ACCESS_CODE=replace_with_owner_code

# Admin JWT signing secret used by the admin middleware/login flow
ADMIN_JWT_SECRET=replace_with_a_strong_random_string

# OpenRouter AI provider (server-only; never expose this to the browser)
OPENROUTER_API_KEY=replace_with_openrouter_api_key
OPENROUTER_TEXT_MODEL=openrouter/free
OPENROUTER_VISION_MODEL=openrouter/free
OPENROUTER_IMAGE_MODEL=openai/gpt-image-2
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=ReachPilot
OPENROUTER_TIMEOUT_MS=60000
OPENROUTER_MAX_RETRIES=2
OPENROUTER_RATE_LIMIT_PER_MINUTE=60

# Admin credentials (use a bcrypt hash for the password)
ADMIN_USERNAME=replace_with_admin_username
ADMIN_PASSWORD_HASH=replace_with_bcrypt_password_hash

# Extension security
EXTENSION_TOKEN_SECRET=replace_with_a_long_random_secret
EXTENSION_ALLOWED_ORIGINS=chrome-extension://replace_with_extension_id,http://localhost:3000
ALLOW_LEGACY_EXTENSION_AUTH=true

# Expo / Mobile
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.50:3000/api

# Other optional keys
#SENTRY_DSN=
#NEXT_PUBLIC_ANALYTICS_ID=
